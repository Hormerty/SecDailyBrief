# Environnement de développement
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Sorties de build (PyInstaller). Le dossier build\ est versionné : il porte le script et
# les propriétés du fichier .exe ; work\ et dist\ sont des sorties jetables.
work/
dist/
*.spec

# Données d'exécution en mode portable
data/

# Aperçus produits en développement
preview.html
preview.txt
# Scripts de verification locaux (WSL)
.tmp/
.venv-linux/
